# Copy this file to .env, fill in your key, then run: node server.mjs
# Never commit .env (it holds your API key). Values in the real environment override this file.

# --- Preset: Google Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
# Newer Gemini models "think" before answering and that eats the token limit; low keeps answers complete and cheap.
LLM_REASONING_EFFORT=low
LLM_API_KEY=

# --- Preset: NVIDIA (key from https://build.nvidia.com) ---
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_API_KEY=

# --- Preset: Groq (https://console.groq.com/keys) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# --- Preset: OpenRouter (https://openrouter.ai/keys) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=

# --- Preset: Ollama (local, no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# Optional: use a different model (or provider) for the judge so its review is independent of the drafter.
# Any value left unset falls back to the LLM_* value above. If JUDGE_BASE_URL differs from LLM_BASE_URL,
# set JUDGE_API_KEY too; the drafter key is never sent to a different host.
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=
# JUDGE_REASONING_EFFORT=

# Minimum milliseconds between LLM requests. Gemini's free tier allows about 5 requests per minute per model,
# so use 13000 there; paid tiers and most other providers can go much lower.
# LLM_MIN_GAP_MS=4000

# Offline run with canned answers; no key and no network needed.
# LLM_PROVIDER=mock

# Port for the local server.
# PORT=8787
